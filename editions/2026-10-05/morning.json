 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-10-05-001",
     "event_id": "EVT-2026-10-05-001",
     "headline": "今週の日本銀行の日程：総裁の挨拶、地域経済報告、月末の会合",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "報道によると、日本銀行は9月の会合で政策金利を1.25%に引き上げたが、次の利上げの時期をめぐる市場の見方は定まっていない。",
       "claimed_mark": "reported_unverified",
       "numbers": [
        {
         "value": 1.25,
         "unit": "%",
         "label": "政策金利"
        }
       ],
       "source_ref": "SRC-015",
       "excerpt": null,
       "attribution": "出典：外為どっとコム「外為どっとコムの検索結果（2026-10-05）」（https://www.gaitame.com/media/entry/2026/10/04/060300）",
       "processing_note": "外為どっとコム「外為どっとコムの検索結果（2026-10-05）」（https://www.gaitame.com/media/entry/2026/10/04/060300）をもとに本サイト作成",
       "mark": "reported_unverified",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "日本銀行の公表予定によると、5日（月）14時に、需給ギャップと潜在成長率などの指標が公表される。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 5,
         "unit": "日",
         "label": "日付（公表日）"
        },
        {
         "value": 14,
         "unit": "時",
         "label": "日付（公表の時刻）"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "10月 5日（月） 8:50 ○ ● 日銀当座預金増減要因（10月見込み） 14:00 ○ ● 需給ギャップ・潜在成長率および労働需給関連指標",
       "attribution": "出典：日本銀行「公表予定」（https://www.boj.or.jp/about/calendar/index.htm）",
       "processing_note": "日本銀行「公表予定」（https://www.boj.or.jp/about/calendar/index.htm）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "同じ公表予定では、6日（火）15時35分に、日本銀行の総裁が全国証券大会で挨拶をする。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 6,
         "unit": "日",
         "label": "日付（挨拶の日）"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "6日（火） 15:35 ○ 【挨拶】",
       "attribution": "出典：日本銀行「公表予定」（https://www.boj.or.jp/about/calendar/index.htm）",
       "processing_note": "日本銀行「公表予定」（https://www.boj.or.jp/about/calendar/index.htm）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "8日（木）14時には、各地域の景気の様子をまとめた「地域経済報告（10月）」が公表される予定である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 8,
         "unit": "日",
         "label": "日付（公表日）"
        },
        {
         "value": 14,
         "unit": "時",
         "label": "日付（公表の時刻）"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "8日（木） 8:50 ○ ● 業種別・地域別直接投資（4～6月期） 14:00 ○ ● 地域経済報告（10月）",
       "attribution": "出典：日本銀行「公表予定」（https://www.boj.or.jp/about/calendar/index.htm）",
       "processing_note": "日本銀行「公表予定」（https://www.boj.or.jp/about/calendar/index.htm）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "次の金融政策決定会合は、10月29日と30日に開かれる予定である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 29,
         "unit": "日",
         "label": "日付（会合の1日目）"
        },
        {
         "value": 30,
         "unit": "日",
         "label": "日付（会合の2日目）"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "次回政策委員会・金融政策決定会合の日程 2026年10月29日（木）、30日（金）",
       "attribution": "出典：日本銀行「公表予定」（https://www.boj.or.jp/about/calendar/index.htm）",
       "processing_note": "日本銀行「公表予定」（https://www.boj.or.jp/about/calendar/index.htm）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "日本銀行が9月30日に公表した予定では、10月に長期国債を買い入れる月間の金額は合計2兆3000億円である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 23000,
         "unit": "億円",
         "label": "10月の長期国債買入れの月間オファー金額の合計"
        }
       ],
       "source_ref": "SRC-012",
       "excerpt": "計 23,000",
       "attribution": "出典：日本銀行「長期国債買入れ（利回り・価格入札方式）の四半期予定（2026年10～12月）」（https://www.boj.or.jp/mopo/mpmdeci/mpr_2026/mpr260930a.pdf）",
       "processing_note": "日本銀行「長期国債買入れ（利回り・価格入札方式）の四半期予定（2026年10～12月）」（https://www.boj.or.jp/mopo/mpmdeci/mpr_2026/mpr260930a.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "報道によると、米国の連邦公開市場委員会（FOMC）の議事要旨で、追加の利上げがどの程度議論されたかにも関心が集まっている。",
