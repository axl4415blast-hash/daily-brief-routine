   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-10-08-001",
     "event_id": "EVT-2026-10-08-001",
     "headline": "9月末の外貨準備高は1兆1,783億ドル余り、前の月から291億ドル余り減った",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "財務省は10月7日、9月末の日本の外貨準備高が1兆1,783億9,600万ドル（1,178,396百万ドル）だったと公表した。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1178396,
         "unit": "百万ドル",
         "label": "外貨準備高（9月末）"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "令和8年9月末における我が国の外貨準備高は、1,178,396百万ドルとなり、令和8年8月末と比べ、29,128百万ドル減少した。",
       "attribution": "出典：財務省「外貨準備等の状況（令和8年9月末現在）」（https://www.mof.go.jp/policy/international_policy/reference/official_reserve_assets/data/0809.html）",
       "processing_note": "財務省「外貨準備等の状況（令和8年9月末現在）」（https://www.mof.go.jp/policy/international_policy/reference/official_reserve_assets/data/0809.html）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "8月末と比べると、291億2,800万ドル（29,128百万ドル）減った。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 29128,
         "unit": "百万ドル",
         "label": "外貨準備高の8月末からの減少額"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "令和8年8月末と比べ、29,128百万ドル減少した。",
       "attribution": "出典：財務省「外貨準備等の状況（令和8年9月末現在）」（https://www.mof.go.jp/policy/international_policy/reference/official_reserve_assets/data/0809.html）",
       "processing_note": "財務省「外貨準備等の状況（令和8年9月末現在）」（https://www.mof.go.jp/policy/international_policy/reference/official_reserve_assets/data/0809.html）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "外貨準備は、為替相場が急に動いたときに国が使えるように持っている、外国のお金や資産のことである。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "中身の多くは証券で、9月末で821,691百万ドルだった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 821691,
         "unit": "百万ドル",
         "label": "外貨準備のうち証券"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "(a) 証券 821,691",
       "attribution": "出典：財務省「外貨準備等の状況（令和8年9月末現在）」（https://www.mof.go.jp/policy/international_policy/reference/official_reserve_assets/data/0809.html）",
       "processing_note": "財務省「外貨準備等の状況（令和8年9月末現在）」（https://www.mof.go.jp/policy/international_policy/reference/official_reserve_assets/data/0809.html）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "預金は155,222百万ドルだった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 155222,
         "unit": "百万ドル",
         "label": "外貨準備のうち預金"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "(b) 預金 155,222",
       "attribution": "出典：財務省「外貨準備等の状況（令和8年9月末現在）」（https://www.mof.go.jp/policy/international_policy/reference/official_reserve_assets/data/0809.html）",
       "processing_note": "財務省「外貨準備等の状況（令和8年9月末現在）」（https://www.mof.go.jp/policy/international_policy/reference/official_reserve_assets/data/0809.html）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "金（きん）は113,592百万ドル分を持っている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 113592,
         "unit": "百万ドル",
         "label": "外貨準備のうち金"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "４．金 113,592",
       "attribution": "出典：財務省「外貨準備等の状況（令和8年9月末現在）」（https://www.mof.go.jp/policy/international_policy/reference/official_reserve_assets/data/0809.html）",
       "processing_note": "財務省「外貨準備等の状況（令和8年9月末現在）」（https://www.mof.go.jp/policy/international_policy/reference/official_reserve_assets/data/0809.html）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "国際通貨基金（IMF）の特別引出権（SDR）は60,783百万ドルだった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 60783,
         "unit": "百万ドル",
         "label": "外貨準備のうちSDR"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "３．ＳＤＲ 60,783",
       "attribution": "出典：財務省「外貨準備等の状況（令和8年9月末現在）」（https://www.mof.go.jp/policy/international_policy/reference/official_reserve_assets/data/0809.html）",
       "processing_note": "財務省「外貨準備等の状況（令和8年9月末現在）」（https://www.mof.go.jp/policy/international_policy/reference/official_reserve_assets/data/0809.html）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-08",
       "text": "外貨準備の額は、持っている外国の債券の値段や、ドル以外の通貨の相場が動くだけでも、ドルで数え直したときに増えたり減ったりする。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-10-08-001-1",
       "text": "外貨準備の減少が、持っている外国の債券の値下がりによるものなら、海外の金利が上がっていた時期と重なる可能性がある。",
       "falsifier": "財務省が今後公表する為替介入の実績で、9月に介入が行われていたと分かれば、この見方は成り立たない。",
       "check_metric": "財務省「外国為替平衡操作の実施状況」と、10月末の外貨準備高",
       "check_by": "2026-11-09"
      }
     ],
     "followup": {
      "is_followup": false,
