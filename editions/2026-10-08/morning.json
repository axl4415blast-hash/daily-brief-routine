   "articles": [
    {
     "article_id": "ART-2026-10-08-002",
     "event_id": "EVT-2026-10-08-002",
     "headline": "通信大手が3本の社債で計324億円を集める（法定書類から）",
     "lines": [
      {
       "line_id": "L-002-01",
       "text": "社債は、会社が投資家からお金を借りるときに発行する証書で、決めた利率で利息を払い、期限に元本を返す。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-002-02",
       "text": "ソフトバンク株式会社が10月7日に出した発行登録追補書類によると、第36回無担保社債（3年債）の利率は年2.564%である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2.564,
         "unit": "%",
         "label": "第36回社債の利率"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "利率(％) 年2.564％",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z6R2）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z6R2）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-03",
       "text": "この3年債の発行価額の総額は252億円（25,200,000,000円）である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 25200000000,
         "unit": "円",
         "label": "第36回社債の発行価額の総額"
        }
       ],
